          tmas scan oci-archive:/tmp/${IMAGE_NAME}.tar \
            --region eu-central-1 \
            --vulnerabilities \
            --malware \
            --secrets \
            --saveSBOM \
            --output json=tmas-report.json

      - name: SBOM und Report anzeigen
        run: |
          echo "=== SBOM ==="
          SBOM_FILE=$(ls SBOM_*.json 2>/dev/null | head -1)
          if [ -n "$SBOM_FILE" ]; then
            echo "Dateigrösse: $(wc -c < $SBOM_FILE) bytes"
            cat "$SBOM_FILE"
          else
            echo "Kein SBOM gefunden"
          fi

      - name: SBOM als Gitea Release Asset hochladen
        env:
          GITEA_TOKEN: 08b861f5a171553b43aca22e1b8ac285d94ea369
        run: |
          SBOM_FILE=$(ls SBOM_*.json 2>/dev/null | head -1)
          SHORT_SHA=$(echo "${{ gitea.sha }}" | cut -c1-7)
          RELEASE_TAG="sbom-${SHORT_SHA}"
          REPO="${{ gitea.repository }}"
          GITEA_INTERNAL="http://gitea:3000"    # für API-Calls intern
          GITEA_EXTERNAL="http://localhost:3000" # für Links nach aussen

          # Release erstellen
          RELEASE_ID=$(curl -s -X POST \
            -H "Authorization: token ${GITEA_TOKEN}" \
            -H "Content-Type: application/json" \
            "${GITEA_INTERNAL}/api/v1/repos/${REPO}/releases" \
            -d "{
              \"tag_name\": \"${RELEASE_TAG}\",
              \"name\": \"SBOM ${SHORT_SHA}\",
              \"body\": \"Automatisch generiertes SBOM für commit ${SHORT_SHA}\",
              \"draft\": false,
              \"prerelease\": true
            }" | jq -r '.id')

          echo "Release ID: ${RELEASE_ID}"

          # SBOM als Asset anhängen
          curl -s -X POST \
            -H "Authorization: token ${GITEA_TOKEN}" \
            -H "Content-Type: application/octet-stream" \
            "${GITEA_INTERNAL}/api/v1/repos/${REPO}/releases/${RELEASE_ID}/assets?name=sbom-${SHORT_SHA}.json" \
            --data-binary @"${SBOM_FILE}"

          echo "SBOM hochgeladen: sbom-${SHORT_SHA}.json"
          echo "Download: ${GITEA_EXTERNAL}/${REPO}/releases/tag/${RELEASE_TAG}"
