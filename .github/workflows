name: Build & Scan Filebrowser
on:
  push:
    branches: [main]
    paths:
      - 'Dockerfile'
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
      - name: Debug Workspace
        run: find / -name "Dockerfile" 2>/dev/null | head -10
      - name: Build Image mit Kaniko
        uses: docker://gcr.io/kaniko-project/executor:latest
        with:
          args: |
            --context=dir:///tmp/act_runner/workdir/${{ gitea.repository }}
            --dockerfile=/tmp/act_runner/workdir/${{ gitea.repository }}/Dockerfile
            --destination=registry:5000/${{ gitea.repository }}:${{ gitea.sha }}
            --destination=registry:5000/${{ gitea.repository }}:latest
            --insecure
            --skip-tls-verify
            
  tmas-scan:
    needs: build
    runs-on: ubuntu-latest
    steps:
      - name: Install curl und jq
        run: |
          apt-get update -qq && apt-get install -y -qq curl jq

      - name: Install TMAS CLI
        run: |
          curl -s https://cli.artifactscan.cloudone.trendmicro.com/tmas-cli/latest/tmas-cli_Linux_x86_64.tar.gz \
            | tar xz -C /usr/local/bin tmas
          tmas version
      
      - name: TMAS Help
        run: tmas scan --help
          
      - name: Pull Image via skopeo
        run: |
          apt-get update -qq && apt-get install -y -qq skopeo
          IMAGE_NAME=$(echo "${{ gitea.repository }}" | sed 's/\//-/g')
          skopeo copy \
            --insecure-policy \
            --src-tls-verify=false \
            docker://registry:5000/${{ gitea.repository }}:latest \
            oci-archive:/tmp/${IMAGE_NAME}.tar
          ls -lh /tmp/${IMAGE_NAME}.tar

